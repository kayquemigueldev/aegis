# AEGIS local development configuration
# Copy to .env and replace placeholder credentials.
# Never commit .env.

# Required by Docker Compose
POSTGRES_PASSWORD=replace_with_a_local_password

# Backend database connection
DB_URL=jdbc:postgresql://127.0.0.1:5434/aegis
DB_USERNAME=aegis

# DB_PASSWORD must match POSTGRES_PASSWORD.
# See README for how to export it.
# DB_PASSWORD=

# Authentication mode: local or database
AEGIS_SECURITY_MODE=local

# Optional local API authentication
# AEGIS_API_USERNAME=
# AEGIS_API_PASSWORD=
# AEGIS_API_SENSORS=

# Optional database administrator bootstrap
# AEGIS_BOOTSTRAP_ADMIN_USERNAME=
# AEGIS_BOOTSTRAP_ADMIN_PASSWORD=
